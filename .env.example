# Public client configuration only.
# Copy this file to .env.local and fill in the Supabase values.
# Never put the Supabase service role key, or any other secret, in a VITE_ variable.
# Add the site URL to Supabase Auth redirect URLs:
#   http://localhost:5173/login
#   http://localhost:5173/reset-password
#
# Apply supabase/migrations/20261002130000_initial_schema.sql
# in the Supabase SQL editor before registering accounts.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public market data. CoinGecko's keyless GBP endpoint is used when this is coingecko or left blank.
# No secret belongs here. The browser polls about once a minute and caches chart history for five minutes.
# CoinGecko does not provide 1-minute candles or an order book on this connection.
VITE_PUBLIC_MARKET_DATA_PROVIDER=coingecko
# VITE_PUBLIC_COINGECKO_API_URL=https://api.coingecko.com/api/v3
